{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pol-skew",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "polskew.ankitkapoor.me", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pol-skew",
      "database_id": "089f29a5-1d79-4936-8ce5-20bd1f96948c",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    // Per-client limit on submit/delete calls. The key is used transiently and never stored.
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  "vars": {
    // Explicit opt-in before the quiz; completed responses are submitted automatically.
    "COLLECTION_ENABLED": "true",
    // Public Turnstile site key. The secret is set with `npx wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFdBbVVxswUvxuvw",
  },
  // Request logs would include client metadata; keep Workers Logs off for this Worker.
  "observability": { "enabled": false },
}
