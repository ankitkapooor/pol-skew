{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pol-skew",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "polskew.ankitkapoor.me", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pol-skew",
      // Replace with the id printed by `npx wrangler d1 create pol-skew`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    // Per-client limit on submit/delete calls. The key is used transiently and never stored.
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  "vars": {
    // Collection stays off until the owner has signed off the data policy (see docs/PRIVACY.md).
    "COLLECTION_ENABLED": "false",
    // Public Turnstile site key. The secret is set with `npx wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SITE_KEY": "",
  },
  // Request logs would include client metadata; keep Workers Logs off for this Worker.
  "observability": { "enabled": false },
}
