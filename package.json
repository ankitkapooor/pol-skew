{
  "name": "pol-skew",
  "version": "2.0.0",
  "private": true,
  "description": "Ideology Inventory: a research-informed political-orientation quiz with balanced item pairs, data-quality checks and optional U.S. benchmarks.",
  "type": "module",
  "license": "MIT",
  "author": "Ankit Kapoor",
  "homepage": "https://polskew.ankitkapoor.me",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "npm run version:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "version:gen": "tsx scripts/instrument-version.ts --write",
    "version:check": "tsx scripts/instrument-version.ts --check",
    "db:migrate:local": "wrangler d1 migrations apply pol-skew --local",
    "db:migrate:remote": "wrangler d1 migrations apply pol-skew --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "jspdf": "4.2.1",
    "svg2pdf.js": "2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.55.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
